{% comment %}
  Wrapper section for themes whose product section can't hold theme blocks
  (e.g. Dawn). Add it to the product template under the main product
  section; it hosts one or more nl-spec-list blocks.
{% endcomment %}

<div
  class="nl-spec-list-section"
  style="--nl-section-pad-top: {{ section.settings.padding_top }}px; --nl-section-pad-bottom: {{ section.settings.padding_bottom }}px; --nl-section-width: {{ section.settings.max_width }}px;"
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .nl-spec-list-section {
    max-width: var(--nl-section-width);
    margin: 0 auto;
    padding: var(--nl-section-pad-top) 1.5rem var(--nl-section-pad-bottom);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Specifications",
  "blocks": [{ "type": "nl-spec-list" }],
  "max_blocks": 2,
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "range", "id": "max_width", "label": "Max width", "min": 400, "max": 1600, "step": 20, "unit": "px", "default": 1200 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 }
  ],
  "presets": [
    {
      "name": "Specifications",
      "blocks": [{ "type": "nl-spec-list" }]
    }
  ]
}
{% endschema %}
